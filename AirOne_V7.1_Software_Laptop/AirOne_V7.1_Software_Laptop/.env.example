# AirOne V7.1 — environment template (copy to .env; .env is git-ignored).
# Every secret lives in the environment. Nothing below ships with a default.

# REQUIRED. JWT signing secret, at least 32 characters of real entropy.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AIRONE_JWT_SECRET=

# First administrator password, used ONLY by `launcher.py --create-admin`
# (min 12 chars, upper+lower+digit+symbol, not the username, not a common word).
# Alternative: `launcher.py --create-admin --generate-password`.
AIRONE_ADMIN_PASSWORD=

# OPTIONAL. Telemetry link key (hex, >= 16 bytes = 32 hex chars) for the
# truncated HMAC-SHA256 frame tag. Must equal AIRONE_LINK_KEY_HEX in the
# firmware. Leave empty to accept unauthenticated frames (state NOT_CONFIGURED).
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AIRONE_LINK_KEY=

# API bind address. Default 127.0.0.1 (plain HTTP, no TLS). Set 0.0.0.0 only
# behind a TLS reverse proxy or inside a container.
AIRONE_API_HOST=127.0.0.1

# Development-only gates. Keep at 0 in any real deployment.
AIRONE_ALLOW_DEFAULT_USERS=0     # 1 = seed demo accounts admin/viewer (must change password)
AIRONE_ALLOW_CORS_WILDCARD=0     # 1 = allow api.cors_origins: ["*"]

# Desktop GUI login (leave empty to start the GUI in UNAUTHENTICATED state).
AIRONE_GUI_USER=
AIRONE_GUI_PASSWORD=

# Serial device of the LoRa E22 USB bridge (default: auto-discover).
AIRONE_SERIAL_PORT=
